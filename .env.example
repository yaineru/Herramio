# Site
NEXT_PUBLIC_SITE_URL=https://www.tudominio.com

# Google Analytics 4 (leave empty to disable analytics entirely)
NEXT_PUBLIC_GA_ID=

# Monetization — keep false until the site has real, organic traffic and is
# ready to request AdSense review. See MONETIZATION.md.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_BELOW_GENERATOR=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# Supabase (backend: auth, database, RLS) — Project Settings → API.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is safe to expose to the browser (RLS
# protects the data). SUPABASE_SERVICE_ROLE_KEY bypasses RLS — server-only,
# never prefix it with NEXT_PUBLIC_, never commit a real value.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Billing — which processor is active. "mercadopago" (default, recommended
# for a Colombia-based merchant) or "stripe". See MONETIZATION.md for the
# researched comparison. Only the selected processor's keys below are used.
BILLING_PROVIDER=mercadopago

# Mercado Pago — Developers panel → Your integrations → Credentials.
# Use TEST credentials (both start with TEST-) until ready to go live.
# MERCADOPAGO_ACCESS_TOKEN and MERCADOPAGO_WEBHOOK_SECRET are server-only.
# Price/plan ids live on the `plans` table (provider_price_id_monthly /
# _annual columns), not here — see MONETIZATION.md.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Stripe (kept implemented for a future international-expansion phase —
# not the default). Dashboard → Developers → API keys / Webhooks. Use
# test-mode keys (sk_test_..., whsec_...) until ready to go live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Semantic originality — optional, only when a real embedding provider is
# configured. Allowed values: mock, openai, cohere, voyage. Keep unset to
# preserve the honest default: semantic analysis not available, lexical engine
# remains the source of truth until a real provider is connected.
EMBEDDING_PROVIDER=
EMBEDDING_PROVIDER_API_KEY=

# Admin panel (/admin) — comma-separated allowlist of emails, server-only.
# Leave empty to disable /admin entirely (it 404s for everyone).
ADMIN_EMAILS=

# Load testing (see TESTING.md) — never set these to true in production.
# TEST_TRAFFIC marks requests as synthetic; ALLOW_LOAD_TEST gates the
# /api/test/ping endpoint so load tests only run where explicitly enabled
# (staging or a dedicated test deployment).
TEST_TRAFFIC=false
ALLOW_LOAD_TEST=false

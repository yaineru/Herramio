# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# local test/lint run artifacts (regenerated on demand, never source of truth)
eslint-report.json
fullsuite.json
fullsuite.log
lint.log
tsc-check.log
vitest-full.json
vitest-full.log
vitest-summary.json
.mp-test-buyer.json
.mp-e2e-user.json
.e2e-users.json
